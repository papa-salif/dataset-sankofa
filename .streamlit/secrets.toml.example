# Gabarit pour Streamlit Community Cloud : copie le contenu (avec les vraies
# valeurs) dans le champ "Secrets" du dashboard de l'app — ne commite jamais
# de vrai secrets.toml dans git.

POSTGRES_HOST = "ep-xxxx.region.aws.neon.tech"
POSTGRES_PORT = "5432"
POSTGRES_DB = "moore_dataset"
POSTGRES_USER = "changeme"
POSTGRES_PASSWORD = "changeme"
POSTGRES_SSLMODE = "require"

CLOUDINARY_CLOUD_NAME = "changeme"
CLOUDINARY_API_KEY = "changeme"
CLOUDINARY_API_SECRET = "changeme"
AUDIO_KEY_PREFIX = "audio"

ADMIN_PASSWORD = "changeme-admin"

CURRENCY = "FCFA"
DEFAULT_RATE_PER_MINUTE = 100
DEFAULT_RATE_PER_TEXT_TRANSLATION = 0
