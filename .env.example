POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=moore_dataset
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
# "prefer" en local (Postgres Docker sans SSL) ; "require" pour Neon ou tout
# autre Postgres managé qui exige une connexion chiffrée.
POSTGRES_SSLMODE=prefer

# Stockage audio (Cloudinary, resource_type="raw" : pas de transformation)
CLOUDINARY_CLOUD_NAME=changeme
CLOUDINARY_API_KEY=changeme
CLOUDINARY_API_SECRET=changeme
AUDIO_KEY_PREFIX=audio

ADMIN_PASSWORD=changeme-admin

CURRENCY=FCFA
DEFAULT_RATE_PER_MINUTE=100
DEFAULT_RATE_PER_TEXT_TRANSLATION=0
